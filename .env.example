# =============================================================================
# Environment Configuration for Herdr Agent Runtime
# =============================================================================
# Copy this file to .env and customize the values.
# DO NOT commit .env to version control!
# =============================================================================

# ── Developer User Password ─────────────────────────────────────────────────
# Change this to a strong password for SSH access.
# Default: agent2024 (CHANGE THIS FOR PRODUCTION!)
DEVELOPER_PASSWORD=agent2024

# ── SSH Authorized Keys ─────────────────────────────────────────────────────
# Paste your SSH public key here for key-based authentication.
# You can add multiple keys separated by newlines.
# Example: ssh-ed25519 AAAAC3NzaC1lZDI1NTE5... user@machine
SSH_AUTHORIZED_KEYS=

# ── Moshi Hook Pairing Token ────────────────────────────────────────────────
# Get this from Moshi app: Settings → Hooks → Copy pairing token
# This enables remote agent approvals from your phone.
MOSHI_HOOK_TOKEN=

# ── Timezone ────────────────────────────────────────────────────────────────
TZ=Asia/Kolkata

# ── Resource Limits ─────────────────────────────────────────────────────────
# CPU cores allocated to the container (e.g. "1.0", "2.0", "4.0")
CPU_LIMIT=2.0
# RAM allocated to the container (e.g. "2G", "4G", "6G", "8G")
RAM_LIMIT=4G

# ── SSH Port ────────────────────────────────────────────────────────────────
# External port mapped to the container's SSH server (default: 2224)
SSH_PORT=2224
